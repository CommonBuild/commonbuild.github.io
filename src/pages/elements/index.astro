---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const elements = await getCollection('elements');
elements.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<StarlightPage frontmatter={{ title: 'Element Library', description: 'All documented building elements with layerset specifications.' }}>
	<p>
		Browse all building elements below. Each entry includes the full layer stack,
		thermal performance (U-value), fire rating, and IFC classification.
	</p>

	<table class="element-table">
		<thead>
			<tr>
				<th>Element</th>
				<th>IFC Class</th>
				<th>Thickness</th>
				<th>U-value</th>
				<th>Fire rating</th>
				<th>Tags</th>
			</tr>
		</thead>
		<tbody>
			{elements.map((el) => (
				<tr>
					<td><a href={`/elements/${el.id}/`}>{el.data.name}</a></td>
					<td><code>{el.data.ifc_class}</code></td>
					<td>{el.data.total_thickness_mm} mm</td>
					<td>{el.data.u_value} W/m²K</td>
					<td>{el.data.fire_rating}</td>
					<td>
						{el.data.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</td>
				</tr>
			))}
		</tbody>
	</table>
</StarlightPage>
