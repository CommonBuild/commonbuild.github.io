---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import LayerStack3D from '../../components/LayerStack3D.astro';
import { getElements, getElementById } from '../../data/index.ts';

export async function getStaticPaths() {
	return getElements().map(el => ({ params: { slug: el.id } }));
}

const { slug } = Astro.params;
const element = getElementById(slug!);
if (!element) return Astro.redirect('/elements/');

function fnClass(fn: string) {
	if (fn.includes('finish'))     return 'fn-finish';
	if (fn.includes('insulation')) return 'fn-insulation';
	if (fn.includes('structural')) return 'fn-structural';
	if (fn.includes('moisture') || fn.includes('vapour')) return 'fn-moisture';
	if (fn.includes('waterproof')) return 'fn-waterproof';
	if (fn.includes('protection')) return 'fn-protection';
	return 'fn-services';
}

// LayerStack3D verwacht het oude layer-formaat (name, material, thickness_mm, function)
const layersForViewer = element.layers.map(l => ({
	position:     l.position,
	name:         l.name,
	material:     l.material?.name ?? l.material_id ?? '',
	thickness_mm: l.thickness_mm,
	function:     l.function,
}));
---

<StarlightPage frontmatter={{ title: element.name, description: element.description ?? element.name }}>
	<p><code>{element.ifc_class}</code></p>
	{element.description && <p>{element.description}</p>}

	<div class="metrics">
		<div class="metric-card">
			<span class="value">{element.total_thickness_mm} mm</span>
			<span class="label">Total thickness</span>
		</div>
		<div class="metric-card">
			<span class="value">{element.u_value} W/m²K</span>
			<span class="label">U-value</span>
		</div>
		<div class="metric-card">
			<span class="value">{element.fire_rating}</span>
			<span class="label">Fire rating</span>
		</div>
		<div class="metric-card">
			<span class="value">{element.layers.length}</span>
			<span class="label">Layers</span>
		</div>
	</div>

	<div>
		{element.tags.map(tag => <span class="tag">{tag}</span>)}
	</div>

	<h2>Layer Stack</h2>
	<p>Listed from exterior (position 1) to interior. Layer thickness is drawn to scale.</p>
	<LayerStack3D layers={layersForViewer} id={element.id} />
	<div class="viewer-legend">
		<div class="viewer-legend-item"><span class="viewer-legend-swatch" style="background:#4ade80"></span>Finish</div>
		<div class="viewer-legend-item"><span class="viewer-legend-swatch" style="background:#fbbf24"></span>Insulation</div>
		<div class="viewer-legend-item"><span class="viewer-legend-swatch" style="background:#60a5fa"></span>Structural</div>
		<div class="viewer-legend-item"><span class="viewer-legend-swatch" style="background:#a78bfa"></span>Moisture control</div>
		<div class="viewer-legend-item"><span class="viewer-legend-swatch" style="background:#22d3ee"></span>Waterproofing</div>
		<div class="viewer-legend-item"><span class="viewer-legend-swatch" style="background:#f472b6"></span>Protection</div>
		<div class="viewer-legend-item"><span class="viewer-legend-swatch" style="background:#94a3b8"></span>Services</div>
	</div>

	<table class="layer-table">
		<thead>
			<tr>
				<th>#</th>
				<th>Layer</th>
				<th>Product</th>
				<th>Thickness</th>
				<th>Function</th>
				<th>Supplier</th>
				<th>Price (excl. VAT)</th>
			</tr>
		</thead>
		<tbody>
			{element.layers.map(layer => (
				<tr>
					<td>{layer.position}</td>
					<td>{layer.name}</td>
					<td>{layer.material?.name ?? layer.material_id ?? '—'}</td>
					<td>{layer.thickness_mm > 0 ? `${layer.thickness_mm} mm` : '—'}</td>
					<td><span class={`tag ${fnClass(layer.function)}`}>{layer.function}</span></td>
					<td>
						{layer.material?.supplier_url
							? <a href={layer.material.supplier_url} target="_blank" rel="noopener">{layer.material.supplier}</a>
							: (layer.material?.supplier ?? '—')}
					</td>
					<td>
						{layer.material?.price_per_unit != null
							? `€${layer.material.price_per_unit.toFixed(2)} / ${layer.material.unit}`
							: '—'}
					</td>
				</tr>
			))}
		</tbody>
	</table>

	<h2>Downloads</h2>
	<p>
		<a href={`/ifc/${element.id}.ifc`} download class="ifc-download-btn">
			⬇ Download IFC file
		</a>
	</p>
	<p style="font-size:0.8rem;color:var(--sl-color-gray-3)">
		IFC4 · IfcMaterialLayerSet · each layer as a separate solid body
	</p>

	<p style="margin-top:2rem"><a href="/elements/">← Back to Element Library</a></p>
</StarlightPage>
