---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getElements } from '../../data/index.ts';

// Wandtypes verrijkt met lagen + materiaaldata via de gedeelde data-helper
const wallTypes = getElements(e => e.category === 'walls').map(e => ({
  id:                e.id,
  name:              e.name,
  total_thickness_mm: e.total_thickness_mm,
  u_value:           e.u_value,
  layers: e.layers.map(l => ({
    position:           l.position,
    name:               l.name,
    material:           l.material?.name ?? l.material_id ?? '',
    material_id:        l.material_id ?? null,
    thickness_mm:       l.thickness_mm,
    function:           l.function,
    mat_name:           l.material?.name           ?? null,
    mat_category:       l.material?.category       ?? null,
    mat_unit:           l.material?.unit           ?? null,
    mat_price_per_unit: l.material?.price_per_unit ?? null,
    mat_price_currency: l.material?.price_currency ?? 'EUR',
    mat_ifc_material_name: l.material?.ifc_material_name ?? null,
    mat_supplier:       l.material?.supplier       ?? null,
    mat_supplier_url:   l.material?.supplier_url   ?? null,
  })),
}));
---

<StarlightPage frontmatter={{ title: 'Uitbouw Configurator', description: 'Configureer je uitbouw: kies afmetingen en wandopbouw, bekijk het grondplan en 3D model, en exporteer naar IFC.' }}>

	<script define:vars={{ wallTypesData: wallTypes }}>
		window.__wallTypes = wallTypesData;
	</script>

	<div class="configurator-layout">

		<!-- ── Controls panel ─────────────────────────────── -->
		<aside class="config-panel">
			<h2>Afmetingen</h2>

			<div class="control-group">
				<label for="slider-width">
					Breedte
					<span class="dim-value" id="val-width">4,00 m</span>
				</label>
				<input type="range" id="slider-width" min="1000" max="8000" step="100" value="4000" />
				<div class="range-limits"><span>1 m</span><span>8 m</span></div>
			</div>

			<div class="control-group">
				<label for="slider-depth">
					Diepte
					<span class="dim-value" id="val-depth">3,00 m</span>
				</label>
				<input type="range" id="slider-depth" min="1000" max="6000" step="100" value="3000" />
				<div class="range-limits"><span>1 m</span><span>6 m</span></div>
			</div>

			<div class="control-group">
				<label for="slider-height">
					Hoogte
					<span class="dim-value" id="val-height">2,80 m</span>
				</label>
				<input type="range" id="slider-height" min="2000" max="4000" step="100" value="2800" />
				<div class="range-limits"><span>2 m</span><span>4 m</span></div>
			</div>

			<div class="control-group">
				<label for="select-wall">
					Wandtype
					<span class="dim-value" id="val-wall-thickness">— mm</span>
				</label>
				<select id="select-wall">
					{wallTypes.map(w => (
						<option value={w.id}>{w.name}</option>
					))}
				</select>
				<div class="wall-meta">U = <span id="val-wall-u">—</span> W/m²K</div>
			</div>

			<div class="metrics-grid">
				<div class="metric-card">
					<span class="value" id="met-floor">12,00</span>
					<span class="label">m² vloer</span>
				</div>
				<div class="metric-card">
					<span class="value" id="met-volume">33,60</span>
					<span class="label">m³ volume</span>
				</div>
			</div>

			<button id="btn-download" class="download-btn">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
				Download IFC
			</button>

			<p class="hint">Sleep en scroll in het 3D venster om te navigeren.</p>
		</aside>

		<!-- ── Right column: 2D plan + 3D view ───────────── -->
		<div class="viewer-column">

			<!-- 2D floor plan -->
			<div class="plan-wrap">
				<svg id="plan-svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
					<defs>
						<pattern id="hatch" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
							<line x1="0" y1="0" x2="0" y2="6" stroke="#94a3b8" stroke-width="1"/>
						</pattern>
					</defs>
				</svg>
			</div>

			<!-- 3D view -->
			<div class="viewer-wrap">
				<canvas id="vol-canvas"></canvas>
			</div>

		</div>

	</div>

	<!-- ── Meetstaat ──────────────────────────────────────────────────────────── -->
	<section class="quantities-section">
		<h2 class="section-title">Meetstaat</h2>
		<p class="section-desc">Berekend op basis van de ingegeven afmetingen en wanddikte.</p>

		<table class="qty-table" id="tbl-meetstaat">
			<thead>
				<tr>
					<th>Element</th>
					<th>Omschrijving</th>
					<th class="num">Breedte (m)</th>
					<th class="num">Hoogte / Diepte (m)</th>
					<th class="num">Opp. (m²)</th>
					<th class="num">Volume (m³)</th>
				</tr>
			</thead>
			<tbody id="tbody-meetstaat">
				<!-- filled by JS -->
			</tbody>
			<tfoot id="tfoot-meetstaat">
				<!-- totals -->
			</tfoot>
		</table>
	</section>

	<!-- ── Bill of Materials ──────────────────────────────────────────────────── -->
	<section class="quantities-section">
		<h2 class="section-title">Bill of Materials</h2>
		<p class="section-desc">Materiaalstaten afgeleid uit de laagopbouw van het geselecteerde wandtype, toegepast op alle wanden.</p>

		<table class="qty-table" id="tbl-bom">
			<thead>
				<tr>
					<th>#</th>
					<th>Laag</th>
					<th>Product</th>
					<th>Categorie</th>
					<th class="num">Dikte (mm)</th>
					<th class="num">Hoeveelheid</th>
					<th class="num">Prijs (ind.)</th>
					<th>Leverancier</th>
				</tr>
			</thead>
			<tbody id="tbody-bom">
				<!-- filled by JS -->
			</tbody>
			<tfoot id="tfoot-bom">
				<!-- price total -->
			</tfoot>
		</table>
	</section>

</StarlightPage>

<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
import { IFCLoader } from 'web-ifc-three';

// ─── Wall data ────────────────────────────────────────────────────────────────
interface LayerData {
	position: number;
	name: string;
	material: string;           // leesbare naam / IFC-fallback
	material_id: string | null;
	thickness_mm: number;
	function: string;
	// Materialen database velden (null als geen material_id gekoppeld)
	mat_name: string | null;
	mat_category: string | null;
	mat_unit: 'm²' | 'lm' | 'm³' | 'kg' | 'stuk' | null;
	mat_price_per_unit: number | null;
	mat_price_currency: string;
	mat_ifc_material_name: string | null;
	mat_supplier: string | null;
	mat_supplier_url: string | null;
}

interface WallType {
	id: string;
	name: string;
	total_thickness_mm: number;
	u_value: number;
	layers: LayerData[];
}

const wallTypes = (window as any).__wallTypes as WallType[];

// ─── State ────────────────────────────────────────────────────────────────────
let widthMm  = 4000;
let depthMm  = 3000;
let heightMm = 2800;
let selectedWall = wallTypes[0] ?? null;

// ─── Three.js setup ───────────────────────────────────────────────────────────
const canvas   = document.getElementById('vol-canvas') as HTMLCanvasElement;
const wrap     = canvas.parentElement as HTMLElement;

const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
renderer.setClearColor(0xf1f5f9);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

const scene  = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(40, 1, 10, 100000);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.07;

scene.add(new THREE.AmbientLight(0xffffff, 2.2));
const sun = new THREE.DirectionalLight(0xffffff, 2.0);
sun.position.set(5000, 8000, 4000);
scene.add(sun);
const fill = new THREE.DirectionalLight(0xffffff, 0.8);
fill.position.set(-3000, 2000, -3000);
scene.add(fill);

const grid = new THREE.GridHelper(20000, 20, 0xbbbbbb, 0xdddddd);
scene.add(grid);

// ─── IFC Loader setup ─────────────────────────────────────────────────────────
const ifcLoader = new IFCLoader();
ifcLoader.ifcManager.setWasmPath('/');   // web-ifc.wasm is served from /public

// Track current model object so we can remove it before loading the next
let currentModel: THREE.Object3D | null = null;
let isLoading = false;
let pendingRefresh = false;

async function loadIfcIntoScene() {
	if (isLoading) { pendingRefresh = true; return; }
	isLoading = true;

	// Remove previous model from scene
	if (currentModel !== null) {
		scene.remove(currentModel);
		currentModel.traverse((child: THREE.Object3D) => {
			if ((child as THREE.Mesh).isMesh) {
				const m = child as THREE.Mesh;
				m.geometry.dispose();
				if (Array.isArray(m.material)) m.material.forEach(mt => mt.dispose());
				else m.material.dispose();
			}
		});
		currentModel = null;
	}

	// Generate IFC string → Blob URL → load via IFCLoader
	const ifcString = generateIFC(widthMm, depthMm, heightMm);
	const blob = new Blob([ifcString], { type: 'application/x-step' });
	const url  = URL.createObjectURL(blob);

	try {
		const model = await ifcLoader.loadAsync(url) as THREE.Object3D;
		model.name = 'ifc-model';

		// web-ifc-three uses MeshLambertMaterial with vertex colors — replace with
		// a standard material that works with our lighting, keep DoubleSide for walls
		model.traverse((child: THREE.Object3D) => {
			if ((child as THREE.Mesh).isMesh) {
				const mesh = child as THREE.Mesh;
				const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
				mesh.material = mats.map(() => new THREE.MeshStandardMaterial({
					color: 0x93c5fd,
					roughness: 0.4,
					metalness: 0.05,
					transparent: true,
					opacity: 0.88,
					side: THREE.DoubleSide,
				}));
			}
		});

		scene.add(model);
		currentModel = model;

		// web-ifc-three rotates IFC (Z-up) → Three.js (Y-up), so use bounding
		// box to reliably fit camera regardless of coordinate transformation
		const box    = new THREE.Box3().setFromObject(model);
		const center = box.getCenter(new THREE.Vector3());
		const size   = box.getSize(new THREE.Vector3());
		const maxDim = Math.max(size.x, size.y, size.z);

		camera.far  = maxDim * 10;
		camera.near = maxDim * 0.001;
		camera.position.set(
			center.x + maxDim * 1.2,
			center.y + maxDim * 0.8,
			center.z + maxDim * 1.4,
		);
		controls.target.copy(center);
		camera.updateProjectionMatrix();
		controls.update();

	} catch (err) {
		console.error('[IFC Loader] Failed to load model:', err);
	} finally {
		URL.revokeObjectURL(url);
		isLoading = false;
		if (pendingRefresh) { pendingRefresh = false; loadIfcIntoScene(); }
	}
}

// Debounce: only reload IFC 200ms after last slider movement
let debounceTimer: ReturnType<typeof setTimeout> | null = null;
function scheduleIfcReload() {
	if (debounceTimer) clearTimeout(debounceTimer);
	debounceTimer = setTimeout(() => loadIfcIntoScene(), 200);
}

function resizeRenderer() {
	const w = wrap.clientWidth;
	const h = Math.max(260, Math.round(w * 0.55));
	renderer.setSize(w, h);
	camera.aspect = w / h;
	camera.updateProjectionMatrix();
}

new ResizeObserver(resizeRenderer).observe(wrap);
resizeRenderer();

(function animate() {
	requestAnimationFrame(animate);
	controls.update();
	renderer.render(scene, camera);
})();

// ─── 2D floor plan (SVG) ─────────────────────────────────────────────────────
const planSvg = document.getElementById('plan-svg') as unknown as SVGSVGElement;

function updatePlan() {
	const t   = selectedWall?.total_thickness_mm ?? 200;
	const W   = widthMm;
	const D   = depthMm;

	// SVG canvas with padding for dimension lines
	const PAD  = 60;   // space for arrows + labels
	const SCALE = 280 / Math.max(W, D);   // fit largest dim into 280 px
	const sw   = Math.round(W * SCALE);
	const sd   = Math.round(D * SCALE);
	const st   = Math.max(4, Math.round(t * SCALE));
	const VW   = sw + PAD * 2;
	const VH   = sd + PAD * 2;
	const ox   = PAD;   // origin x (top-left of outer wall)
	const oy   = PAD;   // origin y

	planSvg.setAttribute('viewBox', `0 0 ${VW} ${VH}`);
	planSvg.setAttribute('width',  String(VW));
	planSvg.setAttribute('height', String(VH));

	// Clear existing dynamic content (keep <defs>)
	const defs = planSvg.querySelector('defs');
	while (planSvg.lastChild && planSvg.lastChild !== defs) {
		planSvg.removeChild(planSvg.lastChild);
	}

	const ns = 'http://www.w3.org/2000/svg';

	function el(tag: string, attrs: Record<string, string | number>) {
		const e = document.createElementNS(ns, tag);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		return e;
	}

	function txt(content: string, attrs: Record<string, string | number>) {
		const e = el('text', attrs);
		e.textContent = content;
		return e;
	}

	function arrow(x1: number, y1: number, x2: number, y2: number, label: string, horiz: boolean) {
		const g = document.createElementNS(ns, 'g');
		// Line
		g.appendChild(el('line', { x1, y1, x2, y2, stroke: '#475569', 'stroke-width': 1.2 }));
		// Arrowheads (simple ticks)
		const size = 5;
		if (horiz) {
			g.appendChild(el('polyline', { points: `${x1 + size},${y1 - size} ${x1},${y1} ${x1 + size},${y1 + size}`, stroke: '#475569', 'stroke-width': 1.2, fill: 'none' }));
			g.appendChild(el('polyline', { points: `${x2 - size},${y2 - size} ${x2},${y2} ${x2 - size},${y2 + size}`, stroke: '#475569', 'stroke-width': 1.2, fill: 'none' }));
			g.appendChild(txt(label, { x: (x1 + x2) / 2, y: y1 - 8, 'text-anchor': 'middle', 'font-size': 11, fill: '#1e293b', 'font-family': 'sans-serif', 'font-weight': '600' }));
		} else {
			g.appendChild(el('polyline', { points: `${x1 - size},${y1 + size} ${x1},${y1} ${x1 + size},${y1 + size}`, stroke: '#475569', 'stroke-width': 1.2, fill: 'none' }));
			g.appendChild(el('polyline', { points: `${x2 - size},${y2 - size} ${x2},${y2} ${x2 + size},${y2 - size}`, stroke: '#475569', 'stroke-width': 1.2, fill: 'none' }));
			g.appendChild(txt(label, { x: x1 - 12, y: (y1 + y2) / 2, 'text-anchor': 'middle', 'font-size': 11, fill: '#1e293b', 'font-family': 'sans-serif', 'font-weight': '600', transform: `rotate(-90, ${x1 - 12}, ${(y1 + y2) / 2})` }));
		}
		return g;
	}

	// Outer wall rectangle (hatch fill)
	planSvg.appendChild(el('rect', { x: ox, y: oy, width: sw, height: sd, fill: 'url(#hatch)', stroke: '#334155', 'stroke-width': 1.5 }));

	// Inner space (clear opening)
	planSvg.appendChild(el('rect', { x: ox + st, y: oy + st, width: sw - 2 * st, height: sd - 2 * st, fill: '#f8fafc', stroke: '#334155', 'stroke-width': 1 }));

	// Dimension: width (top)
	const dimY = oy - 20;
	planSvg.appendChild(el('line', { x1: ox, y1: oy, x2: ox, y2: dimY + 4, stroke: '#94a3b8', 'stroke-width': 1, 'stroke-dasharray': '3,2' }));
	planSvg.appendChild(el('line', { x1: ox + sw, y1: oy, x2: ox + sw, y2: dimY + 4, stroke: '#94a3b8', 'stroke-width': 1, 'stroke-dasharray': '3,2' }));
	planSvg.appendChild(arrow(ox, dimY, ox + sw, dimY, `${(W / 1000).toFixed(2).replace('.', ',')} m`, true));

	// Dimension: depth (left)
	const dimX = ox - 20;
	planSvg.appendChild(el('line', { x1: ox, y1: oy, x2: dimX + 4, y2: oy, stroke: '#94a3b8', 'stroke-width': 1, 'stroke-dasharray': '3,2' }));
	planSvg.appendChild(el('line', { x1: ox, y1: oy + sd, x2: dimX + 4, y2: oy + sd, stroke: '#94a3b8', 'stroke-width': 1, 'stroke-dasharray': '3,2' }));
	planSvg.appendChild(arrow(dimX, oy, dimX, oy + sd, `${(D / 1000).toFixed(2).replace('.', ',')} m`, false));

	// Wall thickness label (bottom-right)
	planSvg.appendChild(txt(`t = ${t} mm`, { x: ox + sw - 4, y: oy + sd + 14, 'text-anchor': 'end', 'font-size': 10, fill: '#64748b', 'font-family': 'sans-serif' }));

	// "Grondplan" label
	planSvg.appendChild(txt('Grondplan', { x: VW / 2, y: VH - 6, 'text-anchor': 'middle', 'font-size': 10, fill: '#94a3b8', 'font-family': 'sans-serif' }));
}

// ─── UI wiring ────────────────────────────────────────────────────────────────
function fmt(mm: number) {
	return (mm / 1000).toFixed(2).replace('.', ',') + ' m';
}

function updateMetrics() {
	const floor = (widthMm / 1000) * (depthMm / 1000);
	const vol   = floor * (heightMm / 1000);
	(document.getElementById('met-floor')  as HTMLElement).textContent = floor.toFixed(2).replace('.', ',');
	(document.getElementById('met-volume') as HTMLElement).textContent = vol.toFixed(2).replace('.', ',');
}

function fNum(n: number, dec = 2): string {
	return n.toFixed(dec).replace('.', ',');
}

function updateTables() {
	const t  = selectedWall?.total_thickness_mm ?? 0;   // mm
	const W  = widthMm  / 1000;   // m
	const D  = depthMm  / 1000;
	const H  = heightMm / 1000;
	const th = t / 1000;           // m

	// ── Meetstaat rows ────────────────────────────────────────────────────────
	// Netto binnenmaatse afmetingen
	const Wi = W - 2 * th;
	const Di = D - 2 * th;

	type Row = { label: string; desc: string; w: number|null; h: number|null; area: number; vol: number; isWall?: boolean };

	const rows: Row[] = [
		{ label: 'Vloer',       desc: 'Netto vloeroppervlakte (binnenmaat)',   w: Wi,   h: Di,   area: Wi * Di,       vol: 0 },
		{ label: 'Voorwand',    desc: `Buitenmaat breedte × hoogte`,           w: W,    h: H,    area: W * H,         vol: W * H * th, isWall: true },
		{ label: 'Achterwand',  desc: `Buitenmaat breedte × hoogte`,           w: W,    h: H,    area: W * H,         vol: W * H * th, isWall: true },
		{ label: 'Linkerwand',  desc: `Netto diepte × hoogte`,                 w: Di,   h: H,    area: Di * H,        vol: Di * H * th, isWall: true },
		{ label: 'Rechterwand', desc: `Netto diepte × hoogte`,                 w: Di,   h: H,    area: Di * H,        vol: Di * H * th, isWall: true },
	];

	const totalWallArea = rows.filter(r => r.isWall).reduce((s, r) => s + r.area, 0);
	const totalWallVol  = rows.filter(r => r.isWall).reduce((s, r) => s + r.vol,  0);

	const tbody = document.getElementById('tbody-meetstaat')!;
	tbody.innerHTML = rows.map(r => `
		<tr>
			<td class="bold">${r.label}</td>
			<td class="muted">${r.desc}</td>
			<td class="num">${r.w !== null ? fNum(r.w) : '—'}</td>
			<td class="num">${r.h !== null ? fNum(r.h) : '—'}</td>
			<td class="num">${fNum(r.area)}</td>
			<td class="num">${r.vol > 0 ? fNum(r.vol, 3) : '—'}</td>
		</tr>`).join('');

	document.getElementById('tfoot-meetstaat')!.innerHTML = `
		<tr class="total-row">
			<td colspan="4">Totaal wanden</td>
			<td class="num">${fNum(totalWallArea)}</td>
			<td class="num">${fNum(totalWallVol, 3)}</td>
		</tr>`;

	// ── Bill of Materials ─────────────────────────────────────────────────────
	const layers = selectedWall?.layers ?? [];
	const tbomBody = document.getElementById('tbody-bom')!;

	if (layers.length === 0) {
		tbomBody.innerHTML = `<tr><td colspan="9" class="muted center">Geen wandtype geselecteerd.</td></tr>`;
		return;
	}

	// Bereken hoeveelheid per laag op basis van eenheid van het materiaal
	function calcQty(l: LayerData, wallArea: number): { qty: number; unit: string } {
		const unit = l.mat_unit ?? 'm²';
		switch (unit) {
			case 'm²':  return { qty: wallArea,                              unit: 'm²' };
			case 'lm':  return { qty: wallArea / (l.thickness_mm / 1000),   unit: 'lm' };  // oppervlakte / dikte = lopende meter per m breedte (indicatief)
			case 'm³':  return { qty: wallArea * (l.thickness_mm / 1000),   unit: 'm³' };
			case 'kg':  return { qty: wallArea,                              unit: 'kg' }; // geen densiteit beschikbaar, toon als m² equivalent
			default:    return { qty: wallArea,                              unit: unit };
		}
	}

	let totalPrice = 0;
	const bomRows = layers.map((l, i) => {
		const { qty, unit } = calcQty(l, totalWallArea);
		const price     = l.mat_price_per_unit !== null ? l.mat_price_per_unit * qty : null;
		const currency  = l.mat_price_currency ?? 'EUR';
		if (price !== null) totalPrice += price;

		const supplierLink = l.mat_supplier_url
			? `<a href="${l.mat_supplier_url}" target="_blank" rel="noopener" class="supplier-link">${l.mat_supplier ?? '↗'}</a>`
			: (l.mat_supplier ?? '<span class="muted">—</span>');

		return `<tr>
			<td class="num muted">${l.position}</td>
			<td class="bold">${l.name}</td>
			<td>${l.mat_name ?? l.material}</td>
			<td><span class="cat-badge cat-${l.mat_category ?? 'overig'}">${l.mat_category ?? '—'}</span></td>
			<td class="num">${l.thickness_mm}</td>
			<td class="num">${fNum(qty)} ${unit}</td>
			<td class="num">${price !== null ? fNum(price) + ' ' + currency : '<span class="muted">—</span>'}</td>
			<td>${supplierLink}</td>
		</tr>`;
	});

	tbomBody.innerHTML = bomRows.join('');

	// Totaalrij prijs
	const tbomFoot = document.getElementById('tfoot-bom')!;
