---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage frontmatter={{ title: 'Uitbouw Configurator', description: 'Stel de breedte en diepte van een uitbouw volume parametrisch in en download het IFC model.' }}>

	<p>Pas de afmetingen van je uitbouw aan via de schuifregelaars. Het 3D model werkt live mee. Download het IFC bestand om het in je BIM software te importeren.</p>

	<div class="configurator-layout">

		<!-- Controls panel -->
		<aside class="config-panel">
			<h2>Afmetingen</h2>

			<div class="control-group">
				<label for="slider-width">
					Breedte
					<span class="dim-value" id="val-width">4,00 m</span>
				</label>
				<input type="range" id="slider-width" min="1000" max="8000" step="100" value="4000" />
				<div class="range-limits"><span>1 m</span><span>8 m</span></div>
			</div>

			<div class="control-group">
				<label for="slider-depth">
					Diepte
					<span class="dim-value" id="val-depth">3,00 m</span>
				</label>
				<input type="range" id="slider-depth" min="1000" max="6000" step="100" value="3000" />
				<div class="range-limits"><span>1 m</span><span>6 m</span></div>
			</div>

			<div class="control-group">
				<label for="slider-height">
					Hoogte
					<span class="dim-value" id="val-height">2,80 m</span>
				</label>
				<input type="range" id="slider-height" min="2000" max="4000" step="100" value="2800" />
				<div class="range-limits"><span>2 m</span><span>4 m</span></div>
			</div>

			<div class="metrics-grid">
				<div class="metric-card">
					<span class="value" id="met-floor">12,00</span>
					<span class="label">m² vloeroppervlak</span>
				</div>
				<div class="metric-card">
					<span class="value" id="met-volume">33,60</span>
					<span class="label">m³ volume</span>
				</div>
			</div>

			<button id="btn-download" class="download-btn">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
				Download IFC
			</button>

			<p class="hint">Sleep en scroll in het 3D venster om te navigeren.</p>
		</aside>

		<!-- 3D viewer -->
		<div class="viewer-wrap">
			<canvas id="vol-canvas"></canvas>
		</div>

	</div>

</StarlightPage>

<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

// ─── State ───────────────────────────────────────────────────────────────────
let widthMm  = 4000;
let depthMm  = 3000;
let heightMm = 2800;

// ─── Three.js setup ──────────────────────────────────────────────────────────
const canvas   = document.getElementById('vol-canvas') as HTMLCanvasElement;
const wrap     = canvas.parentElement as HTMLElement;

const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
renderer.setClearColor(0xf1f5f9);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

const scene  = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(40, 1, 10, 50000);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping  = true;
controls.dampingFactor  = 0.07;

scene.add(new THREE.AmbientLight(0xffffff, 1.8));
const sun = new THREE.DirectionalLight(0xffffff, 1.8);
sun.position.set(5000, 8000, 4000);
scene.add(sun);
const fill = new THREE.DirectionalLight(0xffffff, 0.6);
fill.position.set(-3000, -2000, -3000);
scene.add(fill);

// Grid floor
const grid = new THREE.GridHelper(20000, 20, 0xbbbbbb, 0xdddddd);
grid.position.y = 0;
scene.add(grid);

// Volume mesh
let boxMesh: THREE.Mesh | null    = null;
let edgeMesh: THREE.LineSegments | null = null;

function rebuildBox() {
	if (boxMesh)  { scene.remove(boxMesh);  boxMesh.geometry.dispose(); }
	if (edgeMesh) { scene.remove(edgeMesh); edgeMesh.geometry.dispose(); }

	const geo = new THREE.BoxGeometry(widthMm, heightMm, depthMm);

	boxMesh = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({
		color: 0x93c5fd,
		roughness: 0.45,
		metalness: 0.05,
		transparent: true,
		opacity: 0.82,
	}));
	// Origin at floor level, centred in X/Z
	boxMesh.position.set(widthMm / 2, heightMm / 2, depthMm / 2);
	scene.add(boxMesh);

	edgeMesh = new THREE.LineSegments(
		new THREE.EdgesGeometry(geo),
		new THREE.LineBasicMaterial({ color: 0x1d4ed8, transparent: true, opacity: 0.55 })
	);
	edgeMesh.position.copy(boxMesh.position);
	scene.add(edgeMesh);

	// Reposition camera so the box is fully visible
	const diag = Math.sqrt(widthMm ** 2 + depthMm ** 2 + heightMm ** 2);
	camera.position.set(widthMm * 1.6, heightMm * 1.4, depthMm * 2.2);
	controls.target.set(widthMm / 2, heightMm / 2, depthMm / 2);
	camera.far = diag * 6;
	camera.near = diag * 0.001;
	camera.updateProjectionMatrix();
	controls.update();
}

function resizeRenderer() {
	const w = wrap.clientWidth;
	const h = Math.max(320, Math.round(w * 0.6));
	renderer.setSize(w, h);
	camera.aspect = w / h;
	camera.updateProjectionMatrix();
}

new ResizeObserver(resizeRenderer).observe(wrap);
resizeRenderer();
rebuildBox();

(function animate() {
	requestAnimationFrame(animate);
	controls.update();
	renderer.render(scene, camera);
})();

// ─── UI wiring ───────────────────────────────────────────────────────────────
function fmt(mm: number) {
	return (mm / 1000).toFixed(2).replace('.', ',') + ' m';
}

function updateMetrics() {
	const floor  = (widthMm / 1000) * (depthMm / 1000);
	const vol    = floor * (heightMm / 1000);
	(document.getElementById('met-floor')  as HTMLElement).textContent = floor.toFixed(2).replace('.', ',');
	(document.getElementById('met-volume') as HTMLElement).textContent = vol.toFixed(2).replace('.', ',');
}

function onSlider(id: string, valId: string, setter: (v: number) => void) {
	const el = document.getElementById(id) as HTMLInputElement;
	const lbl = document.getElementById(valId) as HTMLElement;
	el.addEventListener('input', () => {
		const v = parseInt(el.value, 10);
		setter(v);
		lbl.textContent = fmt(v);
		updateMetrics();
		rebuildBox();
	});
}

onSlider('slider-width',  'val-width',  v => { widthMm  = v; });
onSlider('slider-depth',  'val-depth',  v => { depthMm  = v; });
onSlider('slider-height', 'val-height', v => { heightMm = v; });

updateMetrics();

// ─── IFC generator ───────────────────────────────────────────────────────────
function ifcGuid(): string {
	const chars = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_$';
	let s = '';
	for (let i = 0; i < 22; i++) s += chars[Math.floor(Math.random() * chars.length)];
	return s;
}

function f(n: number): string {
	// IFC expects real literals
	return Number.isInteger(n) ? n.toFixed(1) : String(n);
}

function generateIFC(w: number, d: number, h: number): string {
	const now = new Date().toISOString().slice(0, 19);
	const hW = w / 2;
	const hD = d / 2;

	return [
		'ISO-10303-21;',
		'HEADER;',
		`FILE_DESCRIPTION(('ViewDefinition[CoordinationView]'),'2;1');`,
		`FILE_NAME('uitbouw.ifc','${now}',(''),(''),'Commonbuild Web Configurator','Commonbuild','');`,
		`FILE_SCHEMA(('IFC4'));`,
		'ENDSEC;',
		'DATA;',
		`#1=IFCPROJECT('${ifcGuid()}',$,'Uitbouw',$,$,$,$,(#10),#5);`,
		`#2=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);`,
		`#3=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);`,
		`#4=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);`,
		`#5=IFCUNITASSIGNMENT((#3,#4,#2));`,
		`#6=IFCCARTESIANPOINT((0.,0.,0.));`,
		`#7=IFCDIRECTION((0.,0.,1.));`,
		`#8=IFCDIRECTION((1.,0.,0.));`,
		`#9=IFCAXIS2PLACEMENT3D(#6,#7,#8);`,
		`#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#9,$);`,
		`#11=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);`,
		`#12=IFCSITE('${ifcGuid()}',$,'Site',$,$,$,$,$,$,$,$,$,$,$);`,
		`#13=IFCBUILDING('${ifcGuid()}',$,'Gebouw',$,$,$,$,$,$,$,$,$);`,
		`#14=IFCBUILDINGSTOREY('${ifcGuid()}',$,'Begane Grond',$,$,$,$,$,$,$);`,
		`#15=IFCRELAGGREGATES('${ifcGuid()}',$,$,$,#1,(#12));`,
		`#16=IFCRELAGGREGATES('${ifcGuid()}',$,$,$,#12,(#13));`,
		`#17=IFCRELAGGREGATES('${ifcGuid()}',$,$,$,#13,(#14));`,
		`#18=IFCBUILDINGELEMENTPROXY('${ifcGuid()}',$,'Uitbouw Volume',$,$,#24,#39,$,$);`,
		`#19=IFCRELCONTAINEDINSPATIALSTRUCTURE('${ifcGuid()}',$,$,$,(#18),#14);`,
		`#20=IFCCARTESIANPOINT((0.,0.,0.));`,
		`#21=IFCDIRECTION((0.,0.,1.));`,
		`#22=IFCDIRECTION((1.,0.,0.));`,
		`#23=IFCAXIS2PLACEMENT3D(#20,#21,#22);`,
		`#24=IFCLOCALPLACEMENT($,#23);`,
		`#25=IFCCARTESIANPOINT((${f(hW)},${f(hD)}));`,
		`#26=IFCAXIS2PLACEMENT2D(#25,$);`,
		`#27=IFCRECTANGLEPROFILEDEF(.AREA.,$,#26,${f(w)},${f(d)});`,
		`#28=IFCCARTESIANPOINT((0.,0.,0.));`,
		`#29=IFCDIRECTION((0.,0.,1.));`,
		`#30=IFCDIRECTION((1.,0.,0.));`,
		`#31=IFCAXIS2PLACEMENT3D(#28,#29,#30);`,
		`#32=IFCDIRECTION((0.,0.,1.));`,
		`#33=IFCEXTRUDEDAREASOLID(#27,#31,#32,${f(h)});`,
		`#34=IFCCOLOURRGB($,0.58,0.77,0.99);`,
		`#35=IFCSURFACESTYLESHADING(#34,0.18);`,
		`#36=IFCSURFACESTYLE('Uitbouw Volume',.BOTH.,(#35));`,
		`#37=IFCSTYLEDITEM(#33,(#36),$);`,
		`#38=IFCSHAPEREPRESENTATION(#11,'Body','SweptSolid',(#33));`,
		`#39=IFCPRODUCTDEFINITIONSHAPE($,$,(#38));`,
		'ENDSEC;',
		'END-ISO-10303-21;',
	].join('\n');
}

document.getElementById('btn-download')!.addEventListener('click', () => {
	const content = generateIFC(widthMm, depthMm, heightMm);
	const blob    = new Blob([content], { type: 'application/x-step' });
	const url     = URL.createObjectURL(blob);
	const a       = document.createElement('a');
	const wM      = (widthMm  / 1000).toFixed(1).replace('.', '-');
	const dM      = (depthMm  / 1000).toFixed(1).replace('.', '-');
	const hM      = (heightMm / 1000).toFixed(1).replace('.', '-');
	a.href        = url;
	a.download    = `uitbouw_${wM}x${dM}x${hM}.ifc`;
	a.click();
	URL.revokeObjectURL(url);
});
</script>

<style>
.configurator-layout {
	display: grid;
	grid-template-columns: 280px 1fr;
	gap: 1.5rem;
	align-items: start;
	margin-top: 1.5rem;
}

@media (max-width: 800px) {
	.configurator-layout {
		grid-template-columns: 1fr;
	}
}

/* ── Controls panel ── */
.config-panel {
	background: var(--sl-color-gray-7);
	border: 1px solid var(--sl-color-gray-5);
	border-radius: 0.75rem;
	padding: 1.25rem 1.25rem 1rem;
}

.config-panel h2 {
	margin: 0 0 1.1rem;
	font-size: 1rem;
	font-weight: 700;
	color: var(--sl-color-white);
	border: none;
	padding: 0;
}

.control-group {
	margin-bottom: 1.1rem;
}

.control-group label {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	font-size: 0.875rem;
	font-weight: 600;
	color: var(--sl-color-gray-2);
	margin-bottom: 0.4rem;
}

.dim-value {
	font-size: 0.95rem;
	font-weight: 700;
	color: var(--sl-color-accent);
	min-width: 4.5rem;
	text-align: right;
}

input[type='range'] {
	width: 100%;
	accent-color: var(--sl-color-accent);
	cursor: pointer;
}

.range-limits {
	display: flex;
	justify-content: space-between;
	font-size: 0.7rem;
	color: var(--sl-color-gray-4);
	margin-top: 0.15rem;
}

/* ── Metrics ── */
.metrics-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 0.75rem;
	margin: 1.25rem 0 1.25rem;
}

.metric-card {
	background: var(--sl-color-gray-6);
	border: 1px solid var(--sl-color-gray-5);
	border-radius: 0.5rem;
	padding: 0.75rem 0.5rem;
	text-align: center;
}

.metric-card .value {
	display: block;
	font-size: 1.25rem;
	font-weight: 700;
	color: var(--sl-color-accent);
}

.metric-card .label {
	display: block;
	font-size: 0.65rem;
	color: var(--sl-color-gray-3);
	margin-top: 0.2rem;
}

/* ── Download button ── */
.download-btn {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 0.5rem;
	width: 100%;
	padding: 0.65rem 1rem;
	background: var(--sl-color-accent);
	color: #fff;
	border: none;
	border-radius: 0.5rem;
	font-size: 0.95rem;
	font-weight: 700;
	cursor: pointer;
	transition: background 0.15s;
}

.download-btn:hover {
	background: var(--sl-color-accent-high);
}

.hint {
	margin: 0.75rem 0 0;
	font-size: 0.72rem;
	color: var(--sl-color-gray-4);
	text-align: center;
}

/* ── 3D viewer ── */
.viewer-wrap {
	border: 1px solid var(--sl-color-gray-5);
	border-radius: 0.75rem;
	overflow: hidden;
	background: #f1f5f9;
}

.viewer-wrap canvas {
	display: block;
	width: 100%;
}
</style>
