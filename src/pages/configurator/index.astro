// ─── IFC generator ────────────────────────────────────────────────────────────
function ifcGuid(): string {
	const c = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_$';
	let s = '';
	for (let i = 0; i < 22; i++) s += c[Math.floor(Math.random() * c.length)];
	return s;
}

function f(n: number): string {
	return Number.isInteger(n) ? n.toFixed(1) : String(n);
}

// IFC STEP vereist ASCII-only strings. IfcOpenShell accepteert geen \X\ STEP-encoding.
// Strategie: NFD-normaliseer → verwijder combinerende diakritische tekens → vervang
// bekende symbolen door ASCII-equivalent → strip resterende niet-ASCII.
function ifcStr(s: string): string {
	return s
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')  // verwijder combinerende accenten (é→e, ü→u, ...)
		.replace(/×/g, 'x')               // U+00D7 maalteken → x
		.replace(/[^\x00-\x7F]/g, '');    // strip eventuele resterende niet-ASCII tekens
}

// Build one IfcWall with swept-solid geometry and return [lines, wallEntityId, nextId]
function buildIfcWall(
	name: string,
	// position of wall origin (bottom-left corner in plan)
	px: number, py: number,
	// wall runs along X (true) or Z (false)
	alongX: boolean,
	length: number,
	height: number,
	thickness: number,
	startId: number,
	repCtxId: number,   // #11
	storeyPlacementId: number,  // #24 parent placement
): [string[], number, number] {
	let id = startId;
	const lines: string[] = [];

	// Local placement
	const ptId   = id++;
	const zDirId = id++;
	const xDirId = id++;
	const axId   = id++;
	const placId = id++;

	// IFC uses Z-up. For walls along X: localX=(1,0,0), localZ=(0,0,1), localY=(0,1,0→depth).
	// For walls along Y (depth): localX=(0,1,0), localZ=(0,0,1), localY=(-1,0,0).
	// Profile is in local XY plane, extruded along local Z (= up = height).
	const xDir = alongX ? '(1.,0.,0.)' : '(0.,1.,0.)';
	// Profile center: along-X walls → thickness goes in +localY (+depth) → cy = +t/2
	//                 along-Y walls → thickness goes in +localY (-X)   → cy = -t/2 (wall body toward interior)
	const profCY = alongX ? thickness / 2 : -thickness / 2;

	lines.push(`#${ptId}=IFCCARTESIANPOINT((${f(px)},${f(py)},0.));`);
	lines.push(`#${zDirId}=IFCDIRECTION((0.,0.,1.));`);   // local Z = global up
	lines.push(`#${xDirId}=IFCDIRECTION(${xDir});`);
	lines.push(`#${axId}=IFCAXIS2PLACEMENT3D(#${ptId},#${zDirId},#${xDirId});`);
	lines.push(`#${placId}=IFCLOCALPLACEMENT(#${storeyPlacementId},#${axId});`);

	// Profile: rectangle length × thickness, centre offset so body starts at origin corner
	const profPtId  = id++;
	const prof2dId  = id++;
	const profId    = id++;
	const extPtId   = id++;
	const extZId    = id++;
	const extXId    = id++;
	const extAxId   = id++;
	const extDirId  = id++;
	const solidId   = id++;
	const shapeRepId = id++;
	const prodDefId = id++;

	lines.push(`#${profPtId}=IFCCARTESIANPOINT((${f(length / 2)},${f(profCY)}));`);
	lines.push(`#${prof2dId}=IFCAXIS2PLACEMENT2D(#${profPtId},$);`);
	lines.push(`#${profId}=IFCRECTANGLEPROFILEDEF(.AREA.,$,#${prof2dId},${f(length)},${f(thickness)});`);
	lines.push(`#${extPtId}=IFCCARTESIANPOINT((0.,0.,0.));`);
	lines.push(`#${extZId}=IFCDIRECTION((0.,0.,1.));`);
	lines.push(`#${extXId}=IFCDIRECTION((1.,0.,0.));`);
	lines.push(`#${extAxId}=IFCAXIS2PLACEMENT3D(#${extPtId},#${extZId},#${extXId});`);
	lines.push(`#${extDirId}=IFCDIRECTION((0.,0.,1.));`);
	lines.push(`#${solidId}=IFCEXTRUDEDAREASOLID(#${profId},#${extAxId},#${extDirId},${f(height)});`);
	lines.push(`#${shapeRepId}=IFCSHAPEREPRESENTATION(#${repCtxId},'Body','SweptSolid',(#${solidId}));`);

	lines.push(`#${prodDefId}=IFCPRODUCTDEFINITIONSHAPE($,$,(#${shapeRepId}));`);

	const wallId = id++;
	lines.push(`#${wallId}=IFCWALL('${ifcGuid()}',$,'${ifcStr(name)}',$,$,#${placId},#${prodDefId},$);`);

	return [lines, wallId, id];
}

function generateIFC(W: number, D: number, H: number): string {
	const now      = new Date().toISOString().slice(0, 19);
	const layers   = selectedWall?.layers ?? [];
	const wallName = selectedWall?.name ?? 'Wand';
	const t        = selectedWall?.total_thickness_mm ?? 200;

	// ── Fixed header entities (1–17) ──────────────────────────────────────────
	const header = [
		`#1=IFCPROJECT('${ifcGuid()}',$,'Uitbouw',$,$,$,$,(#10),#5);`,
		`#2=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);`,
		`#3=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);`,
		`#4=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);`,
		`#5=IFCUNITASSIGNMENT((#3,#4,#2));`,
		`#6=IFCCARTESIANPOINT((0.,0.,0.));`,
		`#7=IFCDIRECTION((0.,0.,1.));`,
		`#8=IFCDIRECTION((1.,0.,0.));`,
		`#9=IFCAXIS2PLACEMENT3D(#6,#7,#8);`,
		`#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#9,$);`,
		`#11=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);`,
		`#12=IFCSITE('${ifcGuid()}',$,'Site',$,$,$,$,$,$,$,$,$,$,$);`,
		`#13=IFCBUILDING('${ifcGuid()}',$,'Gebouw',$,$,$,$,$,$,$,$,$);`,
		`#14=IFCBUILDINGSTOREY('${ifcGuid()}',$,'Begane Grond',$,$,$,$,$,$,$);`,
		`#15=IFCRELAGGREGATES('${ifcGuid()}',$,$,$,#1,(#12));`,
		`#16=IFCRELAGGREGATES('${ifcGuid()}',$,$,$,#12,(#13));`,
		`#17=IFCRELAGGREGATES('${ifcGuid()}',$,$,$,#13,(#14));`,
		// Storey base placement — AXIS = Z-up (0,0,1), REF = X (1,0,0)
		`#20=IFCCARTESIANPOINT((0.,0.,0.));`,
		`#21=IFCDIRECTION((0.,0.,1.));`,
		`#22=IFCDIRECTION((1.,0.,0.));`,
		`#23=IFCAXIS2PLACEMENT3D(#20,#21,#22);`,
		`#24=IFCLOCALPLACEMENT($,#23);`,
	];

	// ── 4 walls ───────────────────────────────────────────────────────────────
	let nextId = 200;
	const wallLines: string[] = [];
	const wallIds: number[] = [];

	// Front wall  (z=0,  runs along X, full width)
	{
		const [lines, wId, nId] = buildIfcWall('Voorwand',  0, 0,      true,  W,       H, t, nextId, 11, 24);
		wallLines.push(...lines); wallIds.push(wId); nextId = nId;
	}
	// Back wall   (z=D-t, runs along X, full width)
	{
		const [lines, wId, nId] = buildIfcWall('Achterwand', 0, D - t, true,  W,       H, t, nextId, 11, 24);
		wallLines.push(...lines); wallIds.push(wId); nextId = nId;
	}
	// Left wall   (x=0,  runs along Z, fits between front and back)
	{
		const [lines, wId, nId] = buildIfcWall('Linkerwand', 0, t,     false, D - 2*t, H, t, nextId, 11, 24);
		wallLines.push(...lines); wallIds.push(wId); nextId = nId;
	}
	// Right wall  (x=W-t, runs along Z, fits between front and back)
	{
		const [lines, wId, nId] = buildIfcWall('Rechterwand', W - t, t, false, D - 2*t, H, t, nextId, 11, 24);
		wallLines.push(...lines); wallIds.push(wId); nextId = nId;
	}

	// Spatial containment for all 4 walls
	const containId = nextId++;
	wallLines.push(`#${containId}=IFCRELCONTAINEDINSPATIALSTRUCTURE('${ifcGuid()}',$,$,$,(${wallIds.map(i => '#' + i).join(',')}),#14);`);

	// ── Material layer set (shared by all walls) ───────────────────────────────
	const matLines: string[] = [];
	const layerIds: number[] = [];

	for (const layer of layers) {
		const matId   = nextId++;
		const layerId = nextId++;
		matLines.push(`#${matId}=IFCMATERIAL('${ifcStr(layer.material)}',$,$);`);
		matLines.push(`#${layerId}=IFCMATERIALLAYER(#${matId},${f(layer.thickness_mm)},$,'${ifcStr(layer.name)}',$,$,$);`);
		layerIds.push(layerId);
	}

	const layerSetId = nextId++;
	const relMatId   = nextId++;

	// IfcMaterialLayerSet rechtstreeks koppelen aan alle wanden via IfcRelAssociatesMaterial
	matLines.push(`#${layerSetId}=IFCMATERIALLAYERSET((${layerIds.map(i => '#' + i).join(',')}),'${ifcStr(wallName)}',$);`);
	matLines.push(`#${relMatId}=IFCRELASSOCIATESMATERIAL('${ifcGuid()}',$,$,$,(${wallIds.map(i => '#' + i).join(',')}),#${layerSetId});`);

	return [
		'ISO-10303-21;',
		'HEADER;',
		`FILE_DESCRIPTION(('ViewDefinition[CoordinationView]'),'2;1');`,
		`FILE_NAME('uitbouw.ifc','${now}',(''),(''),'Commonbuild Web Configurator','Commonbuild','');`,
		`FILE_SCHEMA(('IFC4'));`,
		'ENDSEC;',
		'DATA;',
		...header,
		...wallLines,
		...matLines,
		'ENDSEC;',
		'END-ISO-10303-21;',
	].join('\n');
}

document.getElementById('btn-download')!.addEventListener('click', () => {
	const content = generateIFC(widthMm, depthMm, heightMm);
	const blob    = new Blob([content], { type: 'application/x-step' });
	const url     = URL.createObjectURL(blob);
	const a       = document.createElement('a');
	const wM = (widthMm  / 1000).toFixed(1).replace('.', '-');
	const dM = (depthMm  / 1000).toFixed(1).replace('.', '-');
	const hM = (heightMm / 1000).toFixed(1).replace('.', '-');
	a.href     = url;
	a.download = `uitbouw_${wM}x${dM}x${hM}.ifc`;
	a.click();
	URL.revokeObjectURL(url);
});
</script>

