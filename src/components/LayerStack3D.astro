---
interface Layer {
	position: number;
	name: string;
	material: string;
	thickness_mm: number;
	function: string;
}

interface Props {
	layers: Layer[];
	id: string;
}

const { layers, id } = Astro.props;
const data = JSON.stringify(layers);
---

<div class="viewer-wrap">
	<canvas id={`canvas-${id}`} class="layer-canvas"></canvas>
	<p class="viewer-hint">Click and drag to rotate · Scroll to zoom</p>
</div>

<script define:vars={{ data, id }}>
	const layers = JSON.parse(data);

	const FN_COLORS = {
		finish:      0x4ade80,
		insulation:  0xfbbf24,
		structural:  0x60a5fa,
		moisture:    0xa78bfa,
		vapour:      0xa78bfa,
		waterproof:  0x22d3ee,
		protection:  0xf472b6,
		services:    0x94a3b8,
	};

	function fnColor(fn) {
		for (const [key, hex] of Object.entries(FN_COLORS)) {
			if (fn.includes(key)) return hex;
		}
		return 0x94a3b8;
	}

	async function init() {
		const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.165.0/build/three.module.js');
		const { OrbitControls } = await import('https://cdn.jsdelivr.net/npm/three@0.165.0/examples/jsm/controls/OrbitControls.js');

		const canvas = document.getElementById(`canvas-${id}`);
		const W = canvas.parentElement.clientWidth;
		const H = Math.min(400, W * 0.6);
		canvas.width = W;
		canvas.height = H;

		// Scene
		const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
		renderer.setSize(W, H);
		renderer.setPixelRatio(window.devicePixelRatio);

		const scene = new THREE.Scene();
		scene.background = new THREE.Color(0xf8f9fa);

		const camera = new THREE.PerspectiveCamera(45, W / H, 0.1, 1000);
		camera.position.set(120, 80, 200);

		const controls = new OrbitControls(camera, renderer.domElement);
		controls.enableDamping = true;
		controls.dampingFactor = 0.08;
		controls.minDistance = 80;
		controls.maxDistance = 500;

		// Lighting
		scene.add(new THREE.AmbientLight(0xffffff, 0.7));
		const sun = new THREE.DirectionalLight(0xffffff, 1.2);
		sun.position.set(200, 300, 200);
		scene.add(sun);

		// Scale: total visible depth mapped to ~150 units, min layer = 4 units
		const MIN_D = 4;
		const TOTAL_VIS = 150;
		const totalMm = layers.reduce((s, l) => s + (l.thickness_mm || 0), 0) || 1;
		const scale = TOTAL_VIS / totalMm;

		const W_BOX = 100;
		const H_BOX = 60;

		let offsetX = 0;
		const group = new THREE.Group();

		layers.forEach((layer) => {
			const depth = Math.max(MIN_D, (layer.thickness_mm || 0) * scale);
			const color = fnColor(layer.function);

			// Main box
			const geo = new THREE.BoxGeometry(depth, H_BOX, W_BOX);
			const mat = new THREE.MeshPhongMaterial({ color, shininess: 40 });
			const mesh = new THREE.Mesh(geo, mat);
			mesh.position.x = offsetX + depth / 2;
			group.add(mesh);

			// Thin edge lines
			const edges = new THREE.EdgesGeometry(geo);
			const lineMat = new THREE.LineBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.25 });
			const lines = new THREE.LineSegments(edges, lineMat);
			lines.position.copy(mesh.position);
			group.add(lines);

			offsetX += depth;
		});

		// Centre the group
		group.position.x = -offsetX / 2;
		scene.add(group);

		// Animate
		function animate() {
			requestAnimationFrame(animate);
			controls.update();
			renderer.render(scene, camera);
		}
		animate();

		// Resize
		window.addEventListener('resize', () => {
			const nW = canvas.parentElement.clientWidth;
			const nH = Math.min(400, nW * 0.6);
			camera.aspect = nW / nH;
			camera.updateProjectionMatrix();
			renderer.setSize(nW, nH);
		});
	}

	init();
</script>

<style>
	.viewer-wrap {
		margin: 1.5rem 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		overflow: hidden;
	}
	.layer-canvas {
		display: block;
		width: 100%;
	}
	.viewer-hint {
		text-align: center;
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
		padding: 0.4rem;
		margin: 0;
		background: var(--sl-color-gray-7);
	}
</style>
