---
interface Layer {
	position: number;
	name: string;
	material: string;
	thickness_mm: number;
	function: string;
}

interface Props {
	layers: Layer[];
	id: string;
}

const { layers, id } = Astro.props;
---

<div class="viewer-wrap">
	<canvas
		class="layer-canvas"
		data-viewer-id={id}
		data-layers={JSON.stringify(layers)}
	></canvas>
	<p class="viewer-hint">Click and drag to rotate · Scroll to zoom</p>
</div>

<script type="module" is:inline>
	const FN_COLORS = {
		finish:      0x4ade80,
		insulation:  0xfbbf24,
		structural:  0x60a5fa,
		moisture:    0xa78bfa,
		vapour:      0xa78bfa,
		waterproof:  0x22d3ee,
		protection:  0xf472b6,
		services:    0x94a3b8,
	};

	function fnColor(fn) {
		for (const [key, hex] of Object.entries(FN_COLORS)) {
			if (fn.includes(key)) return hex;
		}
		return 0x94a3b8;
	}

	async function initViewer(canvas) {
		const layers = JSON.parse(canvas.dataset.layers);

		const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.165.0/build/three.module.js');
		const { OrbitControls } = await import('https://cdn.jsdelivr.net/npm/three@0.165.0/examples/jsm/controls/OrbitControls.js');

		const wrap = canvas.parentElement;
		const W = wrap.clientWidth || 600;
		const H = Math.min(400, W * 0.55);
		canvas.width = W;
		canvas.height = H;
		canvas.style.width = W + 'px';
		canvas.style.height = H + 'px';

		const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
		renderer.setSize(W, H);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		renderer.setClearColor(0xf1f5f9);

		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(45, W / H, 0.1, 2000);
		camera.position.set(100, 90, 220);

		const controls = new OrbitControls(camera, renderer.domElement);
		controls.enableDamping = true;
		controls.dampingFactor = 0.07;

		scene.add(new THREE.AmbientLight(0xffffff, 1.2));
		const dir = new THREE.DirectionalLight(0xffffff, 1.5);
		dir.position.set(150, 200, 150);
		scene.add(dir);
		const fill = new THREE.DirectionalLight(0xffffff, 0.4);
		fill.position.set(-150, -100, -150);
		scene.add(fill);

		// Scale layers: minimum display depth 4 units, total ~150 units
		const MIN_D = 4;
		const TOTAL_VIS = 150;
		const totalMm = layers.reduce((s, l) => s + Math.max(0, l.thickness_mm || 0), 0) || 1;
		const scale = TOTAL_VIS / totalMm;

		const W_BOX = 100;
		const H_BOX = 60;
		const group = new THREE.Group();
		let offsetX = 0;

		layers.forEach((layer) => {
			const depth = Math.max(MIN_D, (layer.thickness_mm || 0) * scale);
			const geo = new THREE.BoxGeometry(depth, H_BOX, W_BOX);

			const mat = new THREE.MeshStandardMaterial({
				color: fnColor(layer.function),
				roughness: 0.6,
				metalness: 0.0,
			});
			const mesh = new THREE.Mesh(geo, mat);
			mesh.position.x = offsetX + depth / 2;
			group.add(mesh);

			const edges = new THREE.EdgesGeometry(geo);
			const lineMat = new THREE.LineBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.2 });
			const lines = new THREE.LineSegments(edges, lineMat);
			lines.position.copy(mesh.position);
			group.add(lines);

			offsetX += depth;
		});

		group.position.x = -offsetX / 2;
		scene.add(group);

		function animate() {
			requestAnimationFrame(animate);
			controls.update();
			renderer.render(scene, camera);
		}
		animate();

		new ResizeObserver(() => {
			const nW = wrap.clientWidth;
			const nH = Math.min(400, nW * 0.55);
			canvas.style.width = nW + 'px';
			canvas.style.height = nH + 'px';
			camera.aspect = nW / nH;
			camera.updateProjectionMatrix();
			renderer.setSize(nW, nH);
		}).observe(wrap);
	}

	document.querySelectorAll('canvas.layer-canvas[data-layers]').forEach(initViewer);
</script>

<style>
	.viewer-wrap {
		margin: 1.5rem 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		overflow: hidden;
	}
	.layer-canvas {
		display: block;
		width: 100%;
	}
	.viewer-hint {
		text-align: center;
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
		padding: 0.4rem;
		margin: 0;
		background: var(--sl-color-gray-7);
	}
</style>
